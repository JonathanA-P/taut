# ==============================================================================
# TAUT Mobile Application Environment Configuration (.env.example)
#
# INSTRUCTIONS:
# 1. Copy this file to .env: `cp .env.example .env`
# 2. Fill in the values provided by your team lead (Alfredo).
# 3. NEVER commit .env, private keys, or service_role secrets to Git.
# ==============================================================================

# Supabase Project Configuration
# Found in: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-anon-key

# OpenStreetMap Overpass API Configuration
# Default public endpoint for testing (subject to rate limiting)
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
OVERPASS_TIMEOUT_SECONDS=15

# Location Configuration
DEFAULT_HEALTHCARE_RADIUS_METERS=10000
LOCATION_UPDATE_INTERVAL_SECONDS=10

# AI / BISINDO Model Configuration (Phase 2)
BISINDO_MODEL_ASSET_PATH=assets/models/bisindo_landmark.tflite
BISINDO_LABELS_PATH=assets/models/bisindo_labels.txt
BISINDO_CONFIDENCE_THRESHOLD=0.75
